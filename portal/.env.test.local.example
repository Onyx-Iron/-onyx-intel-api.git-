# Copy to .env.test.local (gitignored) and fill in the ISOLATED Supabase
# branch / dedicated test project — never the production project.
#
# lib/test-utils/integration-guard.ts refuses to run (throws) if
# TEST_SUPABASE_URL resolves to the production project ref
# (vvnigrbdsipriufhrwbs), no matter what else is set here.

ALLOW_INTEGRATION_TESTS=true
TEST_SUPABASE_URL=https://<isolated-branch-or-test-project-ref>.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=<service-role-key-for-that-isolated-project-only>
